# =================================================================
# 1. AI 核心配置 (Deepseek)
# =================================================================
# 后端使用的 Deepseek API Key (用于姿态分析报告和康复方案生成)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# 前端使用的 Deepseek API Key (Vite 必须以 VITE_ 开头才能暴露给前端)
VITE_DEEPSEEK_API_KEY=your_deepseek_api_key_here

# =================================================================
# 2. 语音识别配置 (讯飞星火 ASR)
# =================================================================
# 讯飞开放平台提供的 APPID, APIKey, APISecret
XFYUN_ASR_APPID=your_xfyun_appid
XFYUN_ASR_API_KEY=your_xfyun_api_key
XFYUN_ASR_API_SECRET=your_xfyun_api_secret

# =================================================================
# 3. 后端服务配置 (Python FastAPI)
# =================================================================
# 允许跨域请求的源 (前端地址)，多个地址用逗号分隔
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 是否开启调试日志 (true/false)
DEBUG_LOGS=false

# =================================================================
# 4. 前端连接配置 (Vite)
# =================================================================
# 后端 API 基础地址
VITE_API_BASE_URL=http://localhost:8002

# 姿态分析 WebSocket 地址
VITE_WS_URL=ws://localhost:8002/ws/analyze

# MedVoice 语音助手插件 API 地址
VITE_MEDVOICE_BASE_URL=http://localhost:5000
